       <center>  <div id="hora">jueves, 26 de marzo de 2026, 11:18:28 GMT-5</div>
        <script>
    function actualizarHora() {
      const ahora = new Date();
      // Mostrar hora adaptada al usuario
      const opciones = {
        weekday: "long",  // día de la semana
        year: "numeric",
        month: "long",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        timeZoneName: "short" // muestra abreviatura de la zona horaria
      };
      const horaLocal = ahora.toLocaleString(undefined, opciones);
      document.getElementById("hora").textContent = horaLocal;
    }

    // Actualiza cada segundo
    setInterval(actualizarHora, 1000);
    actualizarHora();
  </script>
